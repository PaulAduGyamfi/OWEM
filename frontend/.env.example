# Copy to .env. Everything here ships in the app bundle — EXPO_PUBLIC_ vars are
# public by definition, so nothing secret belongs in this file.

# The backend. Set it and the app talks to FastAPI; leave it blank and the app
# runs on in-memory sample data instead.
#
# On a simulator, localhost works. On a real phone over Expo Go it does NOT —
# use your Mac's LAN address, the same one the Expo QR code shows.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
