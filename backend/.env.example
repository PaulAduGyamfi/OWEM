# Copy to .env and replace the dummy values. Never commit .env.

ENVIRONMENT=development

# --- Database ---
# psycopg3 driver. docker compose up -d db starts a matching Postgres.
DATABASE_URL=postgresql+psycopg://owem:not-a-real-password@localhost:5432/owem
SQL_ECHO=false

# Used by docker-compose.yml at the repository root.
POSTGRES_DB=owem
POSTGRES_USER=owem
POSTGRES_PASSWORD=not-a-real-password
POSTGRES_PORT=5432

# --- API ---
API_PREFIX=/api
# Browsers enforce this; phones do not. Narrow it before exposing the API.
CORS_ORIGINS=*

# --- Object storage (receipt photos) ---
# Private bucket, encrypted, pre-signed URLs. Nothing reads these yet.
AWS_REGION=us-east-1
S3_BUCKET=owem-dev-receipts

# --- Auth ---
# ADR-002: one authenticated actor per event, the payer. Until the managed
# provider is wired, every request resolves to this account.
DEV_USER_EMAIL=payer@owem.local
