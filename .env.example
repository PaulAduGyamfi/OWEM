# Copy to .env and replace the dummy values. Never commit .env.
# The backend reads its own copy from backend/.env — see backend/.env.example.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=owem
POSTGRES_USER=owem
POSTGRES_PASSWORD=not-a-real-password

# --- API (FastAPI / uvicorn) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://owem:not-a-real-password@localhost:5432/owem
API_PREFIX=/api

# --- Payer auth (V1: one authenticated actor per event) ---
# ADR-002. Until the managed provider is wired, every request resolves to this
# development account.
DEV_USER_EMAIL=payer@owem.local

# --- Object storage (S3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET=owem-dev-receipts

# --- Frontend (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
