# Copy to .env and replace dummy values. Never commit .env.
# Names follow ASP.NET Core nested-config convention (Section__Key).

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=owem
POSTGRES_USER=owem
POSTGRES_PASSWORD=not-a-real-password

# --- API (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Default=Host=localhost;Port=5432;Database=owem;Username=owem;Password=not-a-real-password

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# --- Payer auth (V1: one authenticated actor per event) ---
Jwt__Issuer=owem-local
Jwt__Audience=owem-local
Jwt__SigningKey=not-a-real-signing-key-use-at-least-32-chars

# --- Object storage (S3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=owem-dev-receipts
